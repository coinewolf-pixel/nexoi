{
  "name": "nexorum-api",
  "main": "api/src/index.ts",
  "compatibility_date": "2024-06-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "${CLOUDFLARE_ACCOUNT_ID}",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  }
}